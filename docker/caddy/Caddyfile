cloud.zircula.org {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	@davDiscovery {
		path /.well-known/caldav /.well-known/caldav/ /.well-known/carddav /.well-known/carddav/
	}
	redir @davDiscovery https://cloud.zircula.org/remote.php/dav/ 301

	handle_path /push/* {
		reverse_proxy notify-push:7867
	}

	handle {
		reverse_proxy nextcloud:80 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}

office.zircula.org {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	reverse_proxy collabora:9980
}

auth.zircula.org {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	handle_path /branding/* {
		root * /srv/authentik-branding
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy authentik-server:9000
	}
}

monitoring.zircula.org {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	reverse_proxy grafana:3000
}

vault.zircula.org {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	reverse_proxy vaultwarden:8080
}

support.zircula.org {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	reverse_proxy libredesk:9000 {
		header_up X-Client-IP {remote_host}
	}
}

talk.cloud.zircula.org {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	reverse_proxy talk-hpb:8081
}
