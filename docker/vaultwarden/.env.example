VAULTWARDEN_DOMAIN=vault.zircula.org

# Keep false except during the short, IP-restricted bootstrap described in the
# README. Set it back to false immediately after the initial owner exists.
VAULTWARDEN_SIGNUPS_ALLOWED=false

# Only these addresses may create organizations. After the initial organizations
# exist, set this to "none" and recreate the container.
VAULTWARDEN_ORG_CREATION_USERS=CHANGE_ME_OWNER_EMAIL

# Keep SSO_ONLY=false during the lockout-safe proof of concept. The production
# decision is documented in docs/11-vaultwarden.md.
VAULTWARDEN_SSO_ENABLED=true
VAULTWARDEN_SSO_ONLY=false
VAULTWARDEN_SSO_CLIENT_ID=CHANGE_ME
VAULTWARDEN_SSO_CLIENT_SECRET=CHANGE_ME

# Existing Manitu mailbox. Port 465 uses implicit TLS (`force_tls` in
# Vaultwarden), not STARTTLS. The username is the complete mailbox address.
# Keep the password only in the local .env and never commit it.
VAULTWARDEN_SMTP_HOST=mail.manitu.de
VAULTWARDEN_SMTP_FROM=noreply@nextcloud.zircula.org
VAULTWARDEN_SMTP_FROM_NAME="WERK x ZIRCULA Vault"
VAULTWARDEN_SMTP_PORT=465
VAULTWARDEN_SMTP_SECURITY=force_tls
VAULTWARDEN_SMTP_USERNAME=noreply@nextcloud.zircula.org
VAULTWARDEN_SMTP_PASSWORD=CHANGE_ME
VAULTWARDEN_SMTP_TIMEOUT=15
