LIBREDESK_DOMAIN=support.zircula.org

# Exactly 32 hexadecimal characters. This key encrypts stored integration
# credentials and must be included in the encrypted secret backup.
# Generate once with: openssl rand -hex 16
LIBREDESK_APP_ENCRYPTION_KEY=CHANGE_ME_32_HEX_CHARACTERS

# The database and role are created once in the central PostgreSQL instance.
# Generate the password with: openssl rand -hex 32
LIBREDESK_DB_NAME=libredesk
LIBREDESK_DB_USER=libredesk
LIBREDESK_DB_PASSWORD=CHANGE_ME

# Must exactly match LIBREDESK_REDIS_PASSWORD in
# docker/libredesk-redis/.env. Generate once with: openssl rand -hex 32
LIBREDESK_REDIS_PASSWORD=CHANGE_ME
