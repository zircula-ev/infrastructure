GRAFANA_VERSION=13.1.1
GRAFANA_DOMAIN=monitoring.zircula.org

# Local Grafana break-glass account. Use a unique username and a long random
# password. These values initialize a fresh Grafana database only.
GRAFANA_ADMIN_USER=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_SECRET_KEY=CHANGE_ME

# Confidential OAuth2/OpenID Connect client created in authentik.
GRAFANA_OIDC_CLIENT_ID=CHANGE_ME
GRAFANA_OIDC_CLIENT_SECRET=CHANGE_ME
