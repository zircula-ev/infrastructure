# General
TZ=Europe/Berlin
AIO_LOG_LEVEL=info

# Image
# Use the official Nextcloud Talk HPB/TURN image.
TALK_HPB_IMAGE=ghcr.io/nextcloud-releases/aio-talk
TALK_HPB_TAG=latest

# Domains and ports
# The Nextcloud instance itself.
NC_DOMAIN=cloud.zircula.org

# Public DNS name of the Talk HPB and integrated TURN/STUN service.
TALK_HOST=talk.cloud.zircula.org
TALK_PORT=3478

# Secrets
# Generate each value separately:
# openssl rand -hex 32
TURN_SECRET=CHANGE_ME
SIGNALING_SECRET=CHANGE_ME
INTERNAL_SECRET=CHANGE_ME
