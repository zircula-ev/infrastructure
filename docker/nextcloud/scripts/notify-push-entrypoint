#!/bin/sh

set -eu

binary="/var/www/html/custom_apps/notify_push/bin/x86_64/notify_push"
redis_password_file="/run/secrets/redis_password"

for variable in \
  POSTGRES_HOST \
  POSTGRES_DB \
  POSTGRES_USER \
  POSTGRES_PASSWORD \
  REDIS_HOST \
  NEXTCLOUD_URL \
  NEXTCLOUD_DATABASE_PREFIX
do
  eval "value=\${${variable}:-}"

  if [ -z "${value}" ]; then
    printf 'Required environment variable is empty: %s\n' "${variable}" >&2
    exit 1
  fi
done

if [ ! -x "${binary}" ]; then
  printf 'notify_push binary is missing or not executable: %s\n' "${binary}" >&2
  exit 1
fi

if [ ! -s "${redis_password_file}" ]; then
  printf 'Redis password file is missing or empty: %s\n' \
    "${redis_password_file}" >&2
  exit 1
fi

urlencode() {
  php -r 'echo rawurlencode(stream_get_contents(STDIN));'
}

database_user="$(
  printf '%s' "${POSTGRES_USER}" \
    | urlencode
)"

database_password="$(
  printf '%s' "${POSTGRES_PASSWORD}" \
    | urlencode
)"

database_name="$(
  printf '%s' "${POSTGRES_DB}" \
    | urlencode
)"

redis_password_plain="$(
  cat "${redis_password_file}"
)"

redis_password="$(
  printf '%s' "${redis_password_plain}" \
    | urlencode
)"

export DATABASE_URL="postgres://${database_user}:${database_password}@${POSTGRES_HOST}/${database_name}"
export REDIS_URL="redis://:${redis_password}@${REDIS_HOST}"
export DATABASE_PREFIX="${NEXTCLOUD_DATABASE_PREFIX}"

unset \
  database_user \
  database_password \
  database_name \
  redis_password_plain \
  redis_password

exec "${binary}" \
  --bind 0.0.0.0 \
  --port 7867 \
  --log-level info \
  --no-ansi
