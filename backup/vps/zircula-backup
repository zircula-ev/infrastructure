#!/usr/bin/env bash

set -Eeuo pipefail

export LC_ALL=C
umask 0027

readonly repository="/opt/zircula/backups/export/restic"
readonly password_file="/etc/zircula-backup/restic-password"
readonly staging_directory="/opt/zircula/backups/staging"
readonly exclude_file="/etc/zircula-backup/restic-excludes"
readonly infrastructure_directory="/opt/zircula/git/infrastructure"
readonly textfile_directory="/srv/zircula/node-exporter/textfile"
readonly metric_file="${textfile_directory}/backup.prom"
readonly started_at="$(date +%s)"

maintenance_enabled_by_script=false
backup_success=0

exec 9>/run/lock/zircula-backup.lock
if ! flock -n 9; then
  printf '%s\n' "Another Zircula backup is already running" >&2
  exit 75
fi

write_metrics() {
  local finished_at duration temporary_metric

  finished_at="$(date +%s)"
  duration="$((finished_at - started_at))"
  temporary_metric="$(mktemp "${textfile_directory}/.backup.prom.XXXXXX")"

  {
    printf '%s\n'       '# HELP zircula_backup_last_run_success Whether the last VPS backup completed successfully.'       '# TYPE zircula_backup_last_run_success gauge'
    printf 'zircula_backup_last_run_success %s\n' "${backup_success}"

    printf '%s\n'       '# HELP zircula_backup_last_run_timestamp_seconds Unix timestamp of the last completed VPS backup attempt.'       '# TYPE zircula_backup_last_run_timestamp_seconds gauge'
    printf 'zircula_backup_last_run_timestamp_seconds %s\n' "${finished_at}"

    printf '%s\n'       '# HELP zircula_backup_last_run_duration_seconds Duration of the last VPS backup attempt.'       '# TYPE zircula_backup_last_run_duration_seconds gauge'
    printf 'zircula_backup_last_run_duration_seconds %s\n' "${duration}"
  } >"${temporary_metric}"

  chmod 0644 "${temporary_metric}"
  mv -f "${temporary_metric}" "${metric_file}"
}

disable_maintenance_if_needed() {
  if [[ "${maintenance_enabled_by_script}" == true ]]; then
    docker compose       -f "${infrastructure_directory}/docker/nextcloud/compose.yaml"       exec -T --user www-data nextcloud       php occ maintenance:mode --off
  fi
}

cleanup() {
  local exit_code="$?"

  disable_maintenance_if_needed || true
  write_metrics || true

  exit "${exit_code}"
}

trap cleanup EXIT

if [[ "${EUID}" -ne 0 ]]; then
  printf '%s\n' "This backup must run as root" >&2
  exit 77
fi

for path in   "${password_file}"   "${exclude_file}"   "${infrastructure_directory}/docker/postgres/compose.yaml"   "${infrastructure_directory}/docker/nextcloud/compose.yaml"
do
  if [[ ! -r "${path}" ]]; then
    printf 'Required path is not readable: %s\n' "${path}" >&2
    exit 78
  fi
done

install -d -o root -g zircula-backup -m 0750   "$(dirname "${repository}")"   "${staging_directory}"

install -d -o root -g root -m 0755 "${textfile_directory}"

export RESTIC_REPOSITORY="${repository}"
export RESTIC_PASSWORD_FILE="${password_file}"

if [[ ! -f "${repository}/config" ]]; then
  restic init
fi

maintenance_state="$(
  docker compose     -f "${infrastructure_directory}/docker/nextcloud/compose.yaml"     exec -T --user www-data nextcloud     php occ config:system:get maintenance     | tr -d '\r'
)"

if [[ "${maintenance_state}" != "true" ]]; then
  docker compose     -f "${infrastructure_directory}/docker/nextcloud/compose.yaml"     exec -T --user www-data nextcloud     php occ maintenance:mode --on

  maintenance_enabled_by_script=true
fi

database_dump="${staging_directory}/postgres-all.sql.zst"
database_dump_temporary="${database_dump}.tmp"

docker compose   -f "${infrastructure_directory}/docker/postgres/compose.yaml"   exec -T postgres   sh -c 'exec pg_dumpall -U "$POSTGRES_USER"'   | zstd --quiet --threads=0 --force       --output "${database_dump_temporary}"

mv -f "${database_dump_temporary}" "${database_dump}"

docker compose   -f "${infrastructure_directory}/docker/vaultwarden/compose.yaml"   exec -T vaultwarden   /vaultwarden backup

grafana_source="/srv/zircula/grafana/data/grafana.db"
grafana_backup="${staging_directory}/grafana.db"

if [[ -f "${grafana_source}" ]]; then
  python3 - "${grafana_source}" "${grafana_backup}" <<'PY'
import sqlite3
import sys

source, target = sys.argv[1:3]

with sqlite3.connect(f"file:{source}?mode=ro", uri=True) as source_db:
    with sqlite3.connect(target) as target_db:
        source_db.backup(target_db)

with sqlite3.connect(f"file:{target}?mode=ro", uri=True) as check_db:
    result = check_db.execute("PRAGMA quick_check").fetchone()[0]

if result != "ok":
    raise SystemExit(f"Grafana SQLite backup check failed: {result}")
PY
fi

restic backup   --tag automated   --exclude-file "${exclude_file}"   /srv/zircula   "${infrastructure_directory}"   "${staging_directory}"

restic forget   --tag automated   --keep-daily 7   --keep-weekly 4   --keep-monthly 6   --prune

restic check

backup_success=1
