#!/usr/bin/env bash

set -Eeuo pipefail

export LC_ALL=C
umask 0027

readonly dataset="DATA_Store/vps-backup"
readonly target="/DATA_Store/vps-backup/mirror"
readonly identity_file="/etc/zircula-backup/vps-ed25519"
readonly remote="zircula-backup@vps.zircula.org"
readonly keep_snapshots=14

exec 9>/run/lock/zircula-backup-pull.lock
if ! flock -n 9; then
  printf '%s\n' "Another Zircula backup pull is already running" >&2
  exit 75
fi

if [[ "${EUID}" -ne 0 ]]; then
  printf '%s\n' "This backup pull must run as root" >&2
  exit 77
fi

for path in "${identity_file}" "${target}"; do
  if [[ ! -e "${path}" ]]; then
    printf 'Required path does not exist: %s\n' "${path}" >&2
    exit 78
  fi
done

rsync   --archive   --hard-links   --numeric-ids   --delete-delay   --partial   --human-readable   --rsh="ssh -i ${identity_file} -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"   "${remote}:/"   "${target}/"

if [[ ! -f "${target}/restic/config" ]]; then
  printf '%s\n' "Mirrored Restic repository has no config file" >&2
  exit 65
fi

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
snapshot="${dataset}@pull-${timestamp}"

zfs snapshot "${snapshot}"

mapfile -t snapshots < <(
  zfs list     -H     -t snapshot     -o name     -s creation     | grep "^${dataset}@pull-"     || true
)

if (( ${#snapshots[@]} > keep_snapshots )); then
  remove_count="$((${#snapshots[@]} - keep_snapshots))"

  for ((index = 0; index < remove_count; index++)); do
    zfs destroy "${snapshots[index]}"
  done
fi
